# Vedic Math Speed Gym — dev environment
# Copy to .env and fill in. NEVER commit real secrets (a leaked key already cost us once).

# Postgres 15 + pgvector ("the Ledger")
DATABASE_URL=postgresql://vmsg:vmsg@localhost:5432/vmsg

# Neo4j 5 ("the GPS")
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vmsg-dev-password

# Redis 7
REDIS_URL=redis://localhost:6379/0

# Auth — shared with the Node game server (deploy-time config, no runtime call)
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Offline entitlement HMAC (server-only; never ships to client)
OFFLINE_TOKEN_SECRET=dev-only-change-me-too

# Feature flags default OFF; flip in DB, not here.

# External services (Phase 1: leave empty until Sprint 1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
