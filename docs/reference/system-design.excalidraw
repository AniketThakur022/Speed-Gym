    {
      "id": "x62wBFMTqDSHtjJPxCqMa",
      "type": "text",
      "x": 1301.3084647707133,
      "y": -115.55442946844437,
      "width": 273.12060546875,
      "height": 179.39999999999998,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
