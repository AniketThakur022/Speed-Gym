      "boundElements": [],
      "updated": 1783768679671,
      "link": null,
      "locked": false,
      "text": "•  Problem renderer  +  on-device answer checker\n     ~68% checked locally · ~25% hard → server · ~7% on sync\n•  IndexedDB / Dexie — offline event queue + problem pool\n•  Service worker (Workbox) + sync trigger\n•  Study-chatbot UI · ad engine (off for kids)\n•  Local / offline multiplayer — WebRTC · QR · pass-and-play\n     (peer-to-peer, needs NO server)",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•  Problem renderer  +  on-device answer checker\n     ~68% checked locally · ~25% hard → server · ~7% on sync\n•  IndexedDB / Dexie — offline event queue + problem pool\n•  Service worker (Workbox) + sync trigger\n•  Study-chatbot UI · ad engine (off for kids)\n•  Local / offline multiplayer — WebRTC · QR · pass-and-play\n     (peer-to-peer, needs NO server)",
      "autoResize": true,
      "lineHeight": 1.15
    },
