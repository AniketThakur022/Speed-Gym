    {
      "id": "7AyFr5YCXf-9QUvFElCn6",
      "type": "text",
      "x": 1931.3084647707133,
      "y": -115.55442946844437,
      "width": 267.340087890625,
      "height": 186.87499999999997,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b23",
      "roundness": null,
      "seed": 1717121429,
      "version": 4,
      "versionNonce": 1739416725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783768679671,
      "link": null,
      "locked": false,
      "text": "•  Socket.IO — lobby / game / spectate (WSS)\n•  Matchmaking  (0.4·θ + 0.6·ELO, ±100)\n•  Bot backfill (after 15 s, ≤45% win, no kids)\n•  Server-authoritative match state\n•  Anti-cheat (reject <200 ms) · disconnect grace\n•  JWT handshake shares Auth's secret\n     (deploy-time config — no runtime call)\n\n•  Basic social — ● live\n     ghost · daily challenge · clips · taunts\n\n•  Boss · relay · tournament · hubs · location\n     ○ Phase 2 (feature-flagged OFF)",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•  Socket.IO — lobby / game / spectate (WSS)\n•  Matchmaking  (0.4·θ + 0.6·ELO, ±100)\n•  Bot backfill (after 15 s, ≤45% win, no kids)\n•  Server-authoritative match state\n•  Anti-cheat (reject <200 ms) · disconnect grace\n•  JWT handshake shares Auth's secret\n     (deploy-time config — no runtime call)\n\n•  Basic social — ● live\n     ghost · daily challenge · clips · taunts\n\n•  Boss · relay · tournament · hubs · location\n     ○ Phase 2 (feature-flagged OFF)",
      "autoResize": true,
      "lineHeight": 1.15
    },
