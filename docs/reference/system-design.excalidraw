    {
      "id": "5gRKM4bWtLjP0s0byVVsD",
      "type": "text",
      "x": 661.3084647707133,
      "y": -119.55442946844437,
      "width": 293.88427734375,
      "height": 172.49999999999997,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1x",
      "roundness": null,
      "seed": 1569322325,
      "version": 4,
      "versionNonce": 1003383925,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783768679671,
      "link": null,
      "locked": false,
      "text": "•  6-station ingestion line (nightly)\n     PDF → chunks → grounded LLM (2/2 consensus)\n     → SymPy math audit → dual-DB write\n•  Parametric generator (Jinja2 + SymPy, no LLM)\n•  5-gate pipeline\n     SymPy · consensus · hallucination · trap · dedup\n•  Trust ladder:\n     quarantine → sandbox → trusted → live\n     only TRUSTED/LIVE is ever served\n     (sandbox never reaches BKT or mocks)\n•  Study-chatbot service (RAG, hints only)\n•  Human review queue",
      "fontSize": 12.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•  6-station ingestion line (nightly)\n     PDF → chunks → grounded LLM (2/2 consensus)\n     → SymPy math audit → dual-DB write\n•  Parametric generator (Jinja2 + SymPy, no LLM)\n•  5-gate pipeline\n     SymPy · consensus · hallucination · trap · dedup\n•  Trust ladder:\n     quarantine → sandbox → trusted → live\n     only TRUSTED/LIVE is ever served\n     (sandbox never reaches BKT or mocks)\n•  Study-chatbot service (RAG, hints only)\n•  Human review queue",
      "autoResize": true,
      "lineHeight": 1.15
    },
