    "examples": [
     {
      "problem_statement": "Multiply 108 × 92 using the Nikhilam base method",
      "solution": [
       {
        "step_num": 1,
        "operation": "Choose the base 100",
        "result": "a=108,\\; b=92,\\; \\text{base}=100",
        "description": "Both numbers are near this power of 10, so Nikhilam applies"
       },
       {
        "step_num": 2,
        "operation": "Write the deviations from the base",
        "result": "108\\to+8,\\quad 92\\to-8",
        "description": "Deviation = number − base"
       },
       {
        "step_num": 3,
        "operation": "Cross-add for the left part",
        "result": "108 + (-8) = 100",
        "description": "Either cross-sum gives the same left part"
       },
       {
        "step_num": 4,
        "operation": "Multiply the deviations for the right part",
        "result": "(+8)\\times(-8) = -64",
        "description": "The right part occupies 2 digits — the width of the base's zeros"
       },
       {
        "step_num": 5,
        "operation": "Complete the negative right part from the base",
        "result": "\\text{the product } -64 \\text{ is negative, so complete it from the base: }\\;\\lceil 64 \\div 100 \\rceil = 1 \\;\\Rightarrow\\; \\text{left } 100 - 1 = 99,\\; \\text{right } 1\\times100 -64 = 36",
        "description": "A negative right part is completed from the base — of any width, not only when it is too wide — and the borrowed multiple of the base is subtracted from the left part."
       },
       {
        "step_num": 6,
        "operation": "Assemble the answer",
        "result": "99\\,|\\,36 = 9936",
        "description": "left \\times 100 + right, with the digits placed by width"
       }
      ],
      "answer": "9936"
     }
    ],
    "version": 1,
    "sourceDocumentId": "pattern:mult_near_base#p?",
    "generationMethod": "template",
    "common_mistakes": [
